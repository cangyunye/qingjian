#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# macOS 壳只能在 Apple 平台编译（见 pre-commit）
excludes=()
if [[ "$(uname -s)" != "Darwin" ]]; then
  excludes+=(--exclude qingjian-macos)
fi
cargo test --workspace --locked "${excludes[@]}"
